# Env and secrets
.env
.env.*
!.env.example
**/hosts.yml
**/*token*
# Design tokens CSS (nie secret) - wymagane w repo (Geex realign F2+)
!bin/apps/web/assets/css/dam-tokens.css
**/*secret*
# Modul szyfrujacy (nie secret) - wymagany w repo i w instalatorze.
# Bez tego wyjatku oauth_integrations.py nie importuje sie u uzytkownika.
# Sam klucz (data/secret.key) zostaje ignorowany.
!bin/apps/desktop/secret_box.py
*.pem
*.p12

# Layout: GIT_ROOT = DAM.exe + DAM-Setup.exe + bin/ (CONTENT_ROOT). Source lives IN bin/.
/bin/*
!/bin/apps/
!/bin/agents/
!/bin/scripts/
!/bin/THEME/
!/bin/docs/
!/bin/installer/
!/bin/instalator/
!/bin/DATABASE/
/DAM.exe
/DAM-Setup.exe
/DAM-Setup-*.exe
/build-dam-exe/
/dist/
/installer/

# Lokalna baza kont (hashe bcrypt) - kanon: bin/DATABASE/dam-local.sqlite
bin/DATABASE/dam-local.sqlite
bin/DATABASE/dam-local.sqlite-*
!bin/DATABASE/users-seed.sqlite
!bin/DATABASE/README.md
# Kopie zapasowe bazy NIE ida do gita. Zrodlo prawdy to Synology
# (/volume1/docker/dam-eta-postgres/DATABASE) plus godzinowy watcher w
# local_bridge.py, ktory pisze tutaj lokalnie. Instalator ich nie pakuje,
# a dam_db.latest_database_dump() czyta katalog, nie git - wiec nic nie traci.
# Brakujacy dump sciaga przycisk "Pobierz dump" (pull_database_dump_now).
# Uwaga: regula musi miec przedrostek bin/, bo wzorzec ze ukosnikiem jest
# kotwiczony do katalogu z .gitignore ("DATABASE/*.sql.gz" NIE lapie bin/).
bin/DATABASE/*.sql.gz
bin/DATABASE/*.sql
bin/DATABASE/*.dump
bin/DATABASE/*.log
bin/apps/desktop/data/*.sqlite
bin/apps/desktop/data/*.sqlite-*
bin/apps/desktop/data/backup*/
bin/apps/desktop/data/backups*/
bin/apps/desktop/data/bound-session.json
bin/apps/desktop/data/webview2-profile/
bin/apps/desktop/data/db-prefer.json
bin/apps/desktop/machine-config.json
bin/apps/web/data/dam-runtime.json
bin/apps/web/data/dam-identity.json
# legacy paths (pre-bin layout) â€” keep if someone checks out old tree
apps/desktop/data/*.sqlite
apps/desktop/data/*.sqlite-*
apps/desktop/data/bound-session.json
apps/desktop/data/webview2-profile/
apps/desktop/machine-config.json
apps/web/data/dam-runtime.json
apps/web/data/dam-identity.json

# Synology Drive traktuje kazdy zapis heartbeatu (co ~15s) w danych runtime jako
# konflikt edycji, gdy dwie maszyny pracuja rownolegle, i tworzy kopie zamiast
# nadpisywac. Bez tej reguly narosloby to znow do setek plikow (2026-09-17: 884
# usuniete recznie). Docelowo katalogi data/ powinny byc wykluczone z sync Synology.
**/*_Conflict.json
**/*_Conflict_*.json

# Postgres na Synology (ADR-009) - haslo/host per-maszyna, nigdy w Git
bin/apps/desktop/data/pg-config.json
bin/apps/desktop/data/pg-config.json.off
bin/apps/desktop/dam-connection.env
apps/desktop/data/pg-config.json
apps/desktop/data/pg-config.json.off
apps/desktop/dam-connection.env
.tmp-syno-deploy/
bin/.tmp-syno-deploy/

