bin/tooling/choco-cache/**
!bin/tooling/choco-cache/.gitkeep
bin/tooling/npm-cache/**
!bin/tooling/npm-cache/.gitkeep
bin/tooling/composer-home/**
!bin/tooling/composer-home/.gitkeep
tooling/bin/
tooling/downloads/**
