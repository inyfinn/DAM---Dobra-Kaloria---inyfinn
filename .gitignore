# Env and secrets
.env
.env.*
!.env.example
**/hosts.yml
**/*token*
# Design tokens CSS (nie secret) — wymagane w repo (Geex realign F2+)
!apps/web/assets/css/dam-tokens.css
**/*secret*
*.pem
*.p12

# Lokalna baza kont (hashe bcrypt) - nie commitowac
apps/desktop/data/*.sqlite
apps/desktop/data/*.sqlite-*
apps/desktop/data/bound-session.json
apps/desktop/data/webview2-profile/
apps/desktop/machine-config.json
apps/web/data/dam-runtime.json
apps/web/data/dam-identity.json

# Postgres na Synology (ADR-009) - haslo/host per-maszyna, nigdy w Git
apps/desktop/data/pg-config.json
apps/desktop/dam-connection.env
.tmp-syno-deploy/

# Dependencies
node_modules/
/vendor/
apps/api/vendor/
# UWAGA: apps/web/assets/vendor/ (Bootstrap, jQuery) MUSI byc w repo - nie ignorowac

# Vault (blobs)
storage/originals/**
!storage/originals/.gitkeep
storage/derivatives/**
!storage/derivatives/.gitkeep

# Tooling - NEVER commit binaries / local stacks (~1GB+)
tooling/bin/
tooling/downloads/**
!tooling/downloads/.gitkeep
tooling/choco-cache/**
!tooling/choco-cache/.gitkeep
tooling/npm-cache/**
!tooling/npm-cache/.gitkeep
tooling/composer-home/**
!tooling/composer-home/.gitkeep

# Postgres data cluster (local)
data/postgres/
data/postgres-logs/
data/postgres/data/**
!data/postgres/.gitkeep
data/postgres/*.log

# Generated thumbs (regenerate locally)
apps/web/data/thumbs/
apps/web/data/audit-log.jsonl

# PAMIEC-PODRECZNA — disk thumb cache on D: (binaries never in git; keep README)
PAMIEC-PODRECZNA/**
!PAMIEC-PODRECZNA/README.md
!PAMIEC-PODRECZNA/.gitkeep
*.avif

# PAMIEC-PODRECZNA - disk AVIF/JPEG thumbs (D: only; NEVER under X:/ or M:/)
PAMIEC-PODRECZNA/thumbs/
PAMIEC-PODRECZNA/**/*.avif
PAMIEC-PODRECZNA/**/*.jpg
PAMIEC-PODRECZNA/**/*.jpeg
PAMIEC-PODRECZNA/**/*.webp
!PAMIEC-PODRECZNA/README.md
!PAMIEC-PODRECZNA/.gitkeep

# Geex logo backups / local only
*.geex-backup.svg

# Cursor / local agent noise
.cursor/
ui-complete/

# Theme vendor noise (keep geex-html-main source, skip zip + vendor docs)
THEME/*.zip
THEME/documentation/
THEME/geex-html-main/**/*.map

# OS / IDE
.DS_Store
Thumbs.db
*.bak-*
.idea/
.vscode/
*.swp

# Agent / debug logs (lokalne, nie commitowac)
debug-*.log

# Scratch QA + duze backupy bundli (lokalne, nie commitowac)
tmp-qa-hub/
backups/**/*.bundle

# Geex realign visual regression PNG (poza repo — patrz agents/shared/geex-realign-plan)
apps/web/_qa/geex-realign-baseline/**/*.png
apps/web/_qa/geex-realign-baseline/**/*.json
apps/desktop/data/*.lock
apps/desktop/logs/
.ralph/logs/
tmp/
tmp_*.txt

# Build / Python
__pycache__/
*.pyc
.venv/
apps/desktop/.venv/
dist/
build/
*.egg-info/

# Laravel
apps/api/storage/logs/*
apps/api/storage/framework/cache/*
apps/api/storage/framework/sessions/*
apps/api/storage/framework/views/*
apps/api/bootstrap/cache/*
