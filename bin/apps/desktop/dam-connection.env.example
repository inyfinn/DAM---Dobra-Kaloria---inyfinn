# Kolejnosc: DDNS (WAN), IP WAN, LAN. QuickConnect / :5001 = DSM, NIE Postgres.
# WAN nie jest "bezpieczniejszy" niz LAN - LAN nie wychodzi w internet.
# Oba adresy sa na liscie, bo z biura LAN nie dziala, a w domu DDNS bywa wolniejszy.

DAM_PG_HOSTS=inyfinn.synology.me,WAN_IP_PLACEHOLDER,LAN_IP_PLACEHOLDER
DAM_PG_HOST=inyfinn.synology.me
DAM_PG_PORT=5433
DAM_PG_DBNAME=dam_eta
DAM_PG_USER=dam_eta
DAM_PG_PASSWORD=REPLACE_ME

# SSH do NAS: klucze w %USERPROFILE%\.ssh i w ZIP na Pulpicie
# (Synology inyfinn.zip + INSTRUKCJA.txt). NIGDY prywatnego klucza w Git.
NAS_SSH_USER=Inyfinn
NAS_SSH_HOST=inyfinn.synology.me
NAS_SSH_PORT=5022
# NAS_SSH_KEY tylko poza repo (plik ~/.ssh/syno_ed25519 lub cursor-cloud-agent)

# OAuth integracje (Asana + Microsoft Graph = Teams/Outlook)
# Redirect URI w konsoli developera: http://127.0.0.1:8766/oauth/callback
DAM_OAUTH_REDIRECT=http://127.0.0.1:8766/oauth/callback
DAM_ASANA_CLIENT_ID=
DAM_ASANA_CLIENT_SECRET=
DAM_MS_CLIENT_ID=
DAM_MS_CLIENT_SECRET=
# Opcjonalnie wlasny klucz Fernet (urlsafe base64 32B). Bez tego: data/.dam-secret.key
# DAM_SECRET_KEY=
