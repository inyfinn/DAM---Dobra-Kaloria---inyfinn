    {
      "id": "corpus_code_doctrine_explorer_freeze_after_wizualizacje",
      "label": "Explorer freeze after Wizualizacje",
      "file_type": "rationale",
      "source_file": "corpus/code-doctrine.md",
      "source_location": "L2094",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Ten sam profil Chrome: Eksplorator OK → Wizualizacje → powrót na Eksplorator. Po wiz DamSearch.reload ciągnie ~9MB file-index z :8765; abort na leave + keep-alive w tym samym user-data-dir potrafi zwisnąć na kolejnym explorer.html mimo curl 200."
    },
    {
      "id": "corpus_code_doctrine_explorer_return_freeze",
      "label": "Explorer return freeze",
      "file_type": "rationale",
      "source_file": "corpus/code-doctrine.md",
      "source_location": "L2094",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "First paint OK, powrót z Wizualizacji: status Ładowanie indeksu, counts …, puste #damExplorerMain. init() jednorazowy bez pageshow/visibilitychange; AbortError na leave fetch; skeleton CATEGORY_CANON z … zostaje."
    },
    {
      "id": "corpus_code_doctrine_category_skeleton_ellipsis",
      "label": "Category skeleton ellipsis",
      "file_type": "rationale",
      "source_file": "corpus/code-doctrine.md",
      "source_location": "L2098",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "paintCategorySkeleton renderuje CATEGORY_CANON od razu z placeholder count … (data-dam-skeleton=1). Puste Kategorie ≠ brak danych na dysku; applyExplorerIndexBundle/bindExplorerData musi zastąpić skeleton po slim index."
    },
    {
      "id": "corpus_code_doctrine_ladowanie_indeksu",
      "label": "Ładowanie indeksu",
      "file_type": "concept",
      "source_file": "corpus/code-doctrine.md",
      "source_location": "L2082",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Status UI podczas bind slim file-index; explorerNeedsBind traktuje ten tekst jako sygnał niedokończonego bindu. Watchdog 8s pokazuje błąd gdy bind nie kończy."
    },
    {
      "id": "corpus_code_doctrine_browser_mcp_hang",
      "label": "cursor-ide-browser stall",
      "file_type": "rationale",
      "source_file": "corpus/code-doctrine.md",
      "source_location": "L626",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "browser_tabs/browser_navigate/browser_cdp Runtime.evaluate wisi minuty podczas gdy curl :8765/:8766 wraca 2xx w ~2ms. Hang MCP ≠ server down; weryfikuj curl przed browser_navigate."
    },
    {
      "id": "corpus_code_doctrine_cdp_runtime_evaluate_hang",
      "label": "CDP Runtime.evaluate hang",
      "file_type": "rationale",
      "source_file": "corpus/code-doctrine.md",
      "source_location": "L157",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Agent death gdy CDP Runtime.evaluate lub browser MCP wisi na ciężkiej stronie po viz; headless --screenshot na tym samym user-data-dir potrafi zablokować kolejny probe mimo zdrowego serwera."
    },
    {
      "id": "corpus_code_doctrine_html_dam_booting",
      "label": "html.dam-booting",
      "file_type": "rationale",
      "source_file": "corpus/code-doctrine.md",
      "source_location": "L2084",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Klasa na documentElement trzyma pointer-events:none / body opacity:0 do unlock. Musi być zdjęta wraz z body.is-booting; failsafe 0ms/50ms/4s w dam-panic-reload + finishBoot/unlockExplorerBoot."
    },
    {
      "id": "corpus_code_doctrine_file_index_slim_explorer",
      "label": "file-index slim fields=explorer",
      "file_type": "rationale",
      "source_file": "corpus/code-doctrine.md",
      "source_location": "L373",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "First paint explorera = GET :8766/file-index?fields=explorer (~512KB) bez files_by_role/wizki/viz_latest. NIGDY data/file-index.json ~9MB na :8765 na main thread."
    },
    {
      "id": "corpus_code_doctrine_damsearch_reload_vs_searchonly",
      "label": "DamSearch.reload vs searchOnly",
      "file_type": "rationale",
      "source_file": "corpus/code-doctrine.md",
      "source_location": "L2086",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Na explorer.html i visualizations.html reload/loadIndexes musi używać searchOnly:true — nie czyścić _DAM_FILE_INDEX ani nie fetchować 9MB file-index. Pełny index tylko poza explorer/viz."
    },
    {
      "id": "corpus_code_doctrine_skip_global_abort",
      "label": "skipGlobalAbort",
      "file_type": "rationale",
      "source_file": "corpus/code-doctrine.md",
      "source_location": "L2098",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Slim index fetch nie może jechać __damRegisterAbort — Chrome abortuje signal przy hide/leave; Escape nadal abortuje inne fetch. pageshow/visibilitychange restartuje bind."
    },
    {
      "id": "corpus_code_doctrine_explorer_f5_white_screen",
      "label": "Explorer F5 white screen",
      "file_type": "rationale",
      "source_file": "corpus/code-doctrine.md",
      "source_location": "L379",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "window.stop/location.replace równolegle z natywnym F5 ucina dokument; jednowątkowy :8765 + Chrome abort 10053. Fix: zero intercept F5, natywny reload, ThreadingMixIn, dam-panic-reload failsafe pageshow."
    },
