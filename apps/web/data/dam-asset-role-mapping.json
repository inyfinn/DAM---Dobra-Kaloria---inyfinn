{
  "version": 1,
  "source": "dam_asset_role_mapping.csv",
  "rules": [
    {
      "folder": "- BRANDING i MARKA -",
      "file_pattern": "*",
      "asset_role": "brand_asset",
      "note": "Logo, kolory, fonty, brandbook"
    },
    {
      "folder": "1 - MATERIAŁY",
      "file_pattern": "KARTA WPROWADZENIA*",
      "asset_role": "document_spec"
    },
    {
      "folder": "1 - MATERIAŁY",
      "file_pattern": "ELEMENTY, ZDJĘCIA",
      "asset_role": "product_photo"
    },
    {
      "folder": "2 - PROJEKT",
      "file_pattern": "*.ai|*.psd|*.psb",
      "asset_role": "artwork_source"
    },
    {
      "folder": "3 - DRUK",
      "file_pattern": "*.pdf",
      "asset_role": "print_ready"
    },
    {
      "folder": "4 - WIZKI",
      "file_pattern": "ENFACE|FRONT|BACK|TYŁ",
      "asset_role": "packshot"
    },
    {
      "folder": "01 - WYKROJNIKI",
      "file_pattern": "fol_jedn_|kar_zbior_",
      "asset_role": "packaging_die"
    },
    {
      "folder": "03 - OPAKOWANIA ZBIORCZE",
      "file_pattern": "DK_karton_*_face_",
      "asset_role": "bulk_packaging_spec"
    },
    {
      "folder": "04 - MATRYCE-MOCKUPY",
      "file_pattern": "848x1200",
      "asset_role": "mockup_template"
    },
    {
      "folder": "- Marki Własne",
      "file_pattern": "ALDI|BIEDRONKA|LIDL",
      "asset_role": "private_label_artwork"
    },
    {
      "folder": "PG BRANDING",
      "asset_role": "brand_asset"
    },
    {
      "folder": "01 SESJE-ZDJĘCIA",
      "asset_role": "product_photo"
    },
    {
      "folder": "02 POS",
      "asset_role": "pos_material"
    },
    {
      "folder": "03 OUTDOOR",
      "asset_role": "outdoor_material"
    },
    {
      "folder": "05 - SOCIAL",
      "file_pattern": "WIDEO|FILM|ANIM",
      "asset_role": "social_video"
    },
    {
      "folder": "05 - SOCIAL",
      "asset_role": "social_asset"
    },
    {
      "folder": "02 SLIDERY KATEGORIE",
      "asset_role": "web_banner"
    },
    {
      "folder": "04 GRAFIKI DO ZESTAWÓW",
      "asset_role": "web_bundle_tile"
    },
    {
      "folder": "05 GRAFIKI PRODUKTÓW",
      "asset_role": "web_product_tile"
    },
    {
      "folder": "06 SLIDERY NA GŁÓWNĄ",
      "asset_role": "web_hero_slider"
    },
    {
      "folder": "07 - E-COMMERCE",
      "asset_role": "ecommerce_ad"
    },
    {
      "folder": "08 - KAMAPANIE",
      "file_pattern": "KV|STATYK|VIDEO",
      "asset_role": "key_visual"
    },
    {
      "folder": "03 - IKONY",
      "asset_role": "icon"
    }
  ]
}
